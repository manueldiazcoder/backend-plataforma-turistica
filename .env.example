# ================================================
# 🌍 VARIABLES DE ENTORNO - EJEMPLO
# Archivo de referencia para configurar entornos
# locales y de producción en la plataforma turística.
#
# 🔐 Este archivo es seguro para subir al repositorio.
# Cada desarrollador debe copiarlo como ".env"
# y reemplazar los valores según su entorno.
# ================================================
# Este archivo define variables usadas por Docker Compose
# para configurar PostgreSQL, PostGIS y pgAdmin.
#
# ⚠️ Cuando se configure el archivo .env real NO subir ese archivo al repositorio
# Añádirlo a .gitignore, Cuando se suba a produccion cambiar las credenciales de ejemplo.
# Cada desarrollador debe tener su propia copia local
# con valores personalizados.
# ================================================


# ================================================
# 🧩 SECCIÓN 1: VARIABLES DE DESARROLLO (local)
# ================================================
# Estas variables se usan cuando se ejecuta:
#   docker-compose --profile dev up -d
# Ideal para entorno de desarrollo local
# ================================================

# Host de la base de datos en entorno local
DB_HOST_DEV=localhost

# Nombre del contenedor de base de datos (solo referencia)
DB_CONTAINER_NAME_DEV=db_dev_plataforma_turistica

# Nombre de la base de datos para entorno local
POSTGRES_DB_DEV=dev_plataforma_turistica

# Credenciales (pueden cambiarse libremente en local)
POSTGRES_USER_DEV=postgres
POSTGRES_PASSWORD_DEV=postgres

# Puerto donde correrá PostgreSQL localmente
DB_PORT_DEV=5432

# Zona horaria (manténer UTC si se usan timestamps)
DB_TZ_DEV=UTC

# ================================================
# 🔐 USUARIOS DE BASE DE DATOS (para Flyway placeholders)
# ================================================
APP_USER_PASSWORD=dev_app_password
MIGRATIONS_USER_PASSWORD=dev_migrations_password
READONLY_USER_PASSWORD=dev_readonly_password
ADMIN_LOW_USER_PASSWORD=dev_adminlow_password
ADMIN_MID_USER_PASSWORD=dev_adminmid_password
ADMIN_HIGH_USER_PASSWORD=dev_adminhigh_password
SUPER_ADMIN_USER_PASSWORD=dev_superadmin_password

# ================================================
# 🏭 SECCIÓN 2: VARIABLES DE PRODUCCIÓN (deploy/staging)
# ================================================
# Estas variables se usan cuando se ejecuta:
#   docker-compose --profile prod up -d
# o cuando se despliega en un servidor remoto.
# ================================================

# Host de la base de datos en producción
DB_HOST_PROD=prod-db-server

# Nombre del contenedor en producción
DB_CONTAINER_NAME_PROD=db_prod_plataforma_turistica

# Nombre de la base de datos en producción
POSTGRES_DB_PROD=plataforma_turistica

# Usuario administrador (debe ser seguro en producción)
POSTGRES_USER_PROD=admin_prod

# Contraseña del usuario (NO usar esta en producción real)
POSTGRES_PASSWORD_PROD=SuperSegura123!.

# Puerto donde correrá PostgreSQL (interno 5432)
DB_PORT_PROD=5432

# Zona horaria para la base en producción
DB_TZ_PROD=UTC


# ================================================
# 🧭 SECCIÓN 3: CONFIGURACIÓN DE PGADMIN
# ================================================
# Credenciales para acceder a la interfaz web de pgAdmin.
# Pueden personalizarse sin afectar a la base de datos.
# ================================================

# Correo de inicio de sesión en pgAdmin
PGADMIN_EMAIL=admin@admin.com

# Contraseña de pgAdmin (cámbiar antes de desplegar)
PGADMIN_PASSWORD=admin

# Puerto donde estará disponible pgAdmin (por defecto 8080)
PGADMIN_PORT=5050
